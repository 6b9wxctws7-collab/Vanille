# =============================================================================
# Umgebungsvariablen – Beispiel
# Kopiere diese Datei zu ".env.local" und trage echte Werte ein.
# Alle Werte sind optional; ohne sie protokolliert die API die Anfragen nur
# serverseitig (kein oeffentliches Speichern).
# =============================================================================

# --- Oeffentliche Seitenkonfiguration -------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example.ch

# --- Web-Analytics (Platzhalter) ------------------------------------------
# Google Analytics Mess-ID (z. B. G-XXXXXXXXXX) ODER Plausible-Domain
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- E-Mail-Versand: Resend (optional) ------------------------------------
# https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@example.ch
CONTACT_FROM_EMAIL=website@example.ch

# --- Supabase (optional) --------------------------------------------------
# https://supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- HubSpot (optional) ---------------------------------------------------
# https://developers.hubspot.com
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# --- Brevo / Sendinblue (optional) ----------------------------------------
# https://www.brevo.com
BREVO_API_KEY=

# --- Mailchimp (optional) -------------------------------------------------
# https://mailchimp.com
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
